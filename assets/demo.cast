[6.02902, "o", "\r\nFoundryAI — an AI startup team for any AI workspace\r\n────────────────────────────────────────────────────────\r\n\r\nDownloading...\r\n  ✓ Claude Code     → ~/.claude/agents, ~/.claude/skills\r\n\r\n121 files installed.\r\n\r\n✓ Done! Restart your AI workspace to pick up the new agents and skills.\r\n\r\n"]
